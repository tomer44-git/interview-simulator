# העתק לקובץ .env ומלא את הערכים האמיתיים
# .env נמצא ב-.gitignore ולעולם לא נדחף

# ---- Claude — יצירת פרסונה, ניהול הראיון, וניקוד ----
# console.anthropic.com
ANTHROPIC_API_KEY=

# ---- Tavily — חיפוש אינטרנט עבור סוכני המחקר ----
# app.tavily.com
# שים לב: כל ראיון שורף כ-24 חיפושים
TAVILY_API_KEY=

# ---- Redis — broker ו-backend של Celery ----
# מקומי: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ---- Supabase — אימות ושמירת סשנים ----
# Settings → API
SUPABASE_URL=
SUPABASE_KEY=
# Settings → API Keys → Secret key. שרת בלבד, לעולם לא בצד הלקוח.
SUPABASE_SERVICE_KEY=
